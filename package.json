{
  "name": "sunar-karighar",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-check.js",
    "format": "prettier --write client/src server/src tests",
    "start:deploy": "npm run seed && npm start"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0"
  }
}
